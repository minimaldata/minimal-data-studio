{
  "format": 1,
  "name": "MDM executive dashboard",
  "entry": "index.html",
  "styles": [
    "styles.css"
  ],
  "scripts": [
    "dashboard.js"
  ],
  "inputs": {
    "monthly": {
      "label": "Executive monthly metrics",
      "required": true,
      "columns": {
        "month_end": "date",
        "mrr_usd": "number",
        "active_accounts": "number"
      },
      "sql": "queries/monthly.sql"
    },
    "bridge": {
      "label": "Monthly MRR movement",
      "required": true,
      "columns": {
        "month_end": "date",
        "net_new_mrr_usd": "number"
      },
      "sql": "queries/bridge.sql"
    },
    "mix": {
      "label": "Product and customer mix",
      "required": true,
      "columns": {
        "month_end": "date",
        "employee_band": "string",
        "workspace_mrr_usd": "number",
        "analytics_mrr_usd": "number"
      },
      "sql": "queries/mix.sql"
    }
  }
}